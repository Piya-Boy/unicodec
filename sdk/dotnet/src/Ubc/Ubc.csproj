<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ubc</RootNamespace>
    <AssemblyName>Ubc</AssemblyName>
    <PackageId>Ubc</PackageId>
    <Description>Universal Binary Container (UBC) v1 reference SDK for .NET.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes internal members (e.g. Crypto.RootKeyForTesting) to the conformance test
         project only, mirroring the Java port's package-private test-visibility pattern. -->
    <InternalsVisibleTo Include="Ubc.Tests" />
  </ItemGroup>

</Project>
